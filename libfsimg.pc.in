prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: libfsimg
Description: Bounded filesystem image readers, writers and extraction
Version: @PACKAGE_VERSION@
Libs: -L"${libdir}" -lfsimg
Libs.private: @ZLIB_LIBS@ @ZSTD_LIBS@ @LZMA_LIBS@
Cflags: -I"${includedir}"
