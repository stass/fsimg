set -eu
if test -z '@RUBY@' || ! '@RUBY@' -rdigest -rfileutils -rjson -rminitest/autorun -rpathname -rpty \
    -rset -rsocket -rstringio -rtmpdir -rzlib -rio/nonblock -rtimeout -e \
    'exit(Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.2"))' >/dev/null 2>&1; then
    echo 'SKIP: CLI integration requires Ruby 3.2 or later and its suite libraries (including Minitest)'
    exit 77
fi
exec '@RUBY@' '@abs_top_srcdir@/test/cli/run.rb' ./fsimg
