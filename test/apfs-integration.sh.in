#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Stanislav Sedov <stas@deglitch.com>
#
# fsimg's APFS reader against independent evidence: the native captures
# FSIMG_APFS_NATIVE names, through the native CLI tests and the oracles
# (fsck_apfs, apfsck, fsapfsinfo, apfs-dump-quick) the host has, and the
# specimens FSIMG_APFS_CORPUS names against their MATRIX.md rows. Each
# part without its input or tool is reported as skipped, never passed.
# Checker agreement passes only when both accept; both refusals skip with
# both reasons. Missing verdicts fail. Exit 1 if any comparison fails,
# 0 if any passes and none fail, and 77 otherwise.
set -eu
ulimit -c 0
if test -z '@RUBY@' || ! '@RUBY@' -rminitest -e \
    'exit(Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.2"))' >/dev/null 2>&1; then
    echo 'SKIP: APFS integration requires Ruby 3.2 or later with Minitest'
    exit 77
fi
'@RUBY@' '@abs_top_srcdir@/test/apfs-integration-test.rb'
exec '@RUBY@' '@abs_top_srcdir@/test/apfs-integration.rb' "$(pwd)/fsimg"
