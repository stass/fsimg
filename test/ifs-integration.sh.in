#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Stanislav Sedov <stas@deglitch.com>
#
# Independent QNX ImageFS evidence. The fixtures are external inputs that
# are never redistributed:
#   FSIMG_IFS_NATIVE  the QNX 6.5.0 captures directory
#                     (docs/ifs-research.md): bare images under cases/ and
#                     the decoded S1 and S2 bodies under decoded/
#   FSIMG_IFS_IMAGES  a directory of the licensed S1 (H3) and S2 (X1) boot
#                     images and their `dumpifs -u` copies; a compressed
#                     boot image is read whole through the ifsboot
#                     container, and the body of a bare or uncompressed one
#                     as a slice, through info and verification alone
#   DUMPIFS           an lclevy/dumpifs command at a pinned revision, run
#                     as $DUMPIFS IMAGE
#   QNXPROBE          a qnxprobe command at a pinned revision, run as
#                     $QNXPROBE IMAGE
#   FSIMG_HBCIFS_IMAGE    the hbcifs container PCM3_IFS2.ifs of the PCM 3.1
#   FSIMG_HBCIFS_DECODED  update disc, and its payload decoded by the
#                     out-of-tree liblzo2 oracle (docs/ifs-research.md)
#
# Generated boot images of each prefix and compression value, which
# test-ifsboot emits, list, extract and verify through the command as
# their bare body does. The captures are compared with test-ifs's model by
# test-ifs --native, the boot images and E7 and E10 captures with their
# decoded bodies by test-ifsboot --native, and, through the command, with
# the research decoder ifsdump.py by test/ifs-native.py, which first checks
# itself on two generated images.
# dumpifs and qnxprobe, when given, must accept every bare image fsimg
# verifies. The hbcifs container must decode to the oracle's bytes, list and
# extract as that decode's manifest says, verify with its two unidentified
# fields named, and fail at a spool limit below its decoded length. Member
# names are image data: only counts and image file names
# are printed, and fsimg's and the oracles' diagnostics, which can quote a
# name, are discarded. Each unavailable check is reported as a skip.
set -eu
ran=0
python='@PYTHON3@'
native_tool='@abs_top_srcdir@/test/ifs-native.py'
ifsdump='@abs_top_srcdir@/tools/qnx/decode/ifsdump.py'
fixture=$(mktemp -d "${TMPDIR:-/tmp}/fsimg-ifs-oracle-XXXXXX")
trap 'rm -rf "$fixture"' EXIT HUP INT TERM

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

# Full verification of the image at byte $2 of file $1, $3 bytes long, with
# payload read-through; the JSON verify record goes to the file $4. It
# fails unless the report is complete.
fsimg_verify() {
    ./fsimg W --json -d --offset="$2" --length="$3" -f "$1" > "$4" \
        2> /dev/null && grep -q '"type":"verify","complete":true' "$4"
}

# Full verification of the boot image file $1 through the ifsboot
# container it is detected as, with payload read-through; the JSON verify
# record goes to the file $2. It fails unless the report is complete and
# names the container.
boot_verify() {
    ./fsimg W --json -d -f "$1" > "$2" 2> /dev/null &&
        grep -q '"type":"verify","complete":true' "$2" &&
        grep -q '"type":"verify".*"container":"ifsboot"' "$2"
}

# The value of counter $1 in the verify record file $2, which must hold it.
verify_count() {
    value=$(sed -n 's/.*"type":"verify".*"'"$1"'":"\([0-9]*\)".*/\1/p' "$2")
    test -n "$value" || fail "the verify record has no $1"
    echo "$value"
}

# Whether oracle command $1 accepts the image file $2. Its output names
# members, so it is discarded.
oracle_accepts() {
    # DUMPIFS and QNXPROBE may hold arguments, so they are split into
    # words on purpose, without pathname expansion.
    set -f
    # shellcheck disable=SC2086
    if $1 "$2" > /dev/null 2>&1; then
        set +f
        return 0
    fi
    set +f
    return 1
}

# Every bare image fsimg verifies, among the files $@, must be accepted by
# each oracle given; prints the counts.
oracle_compare() {
    verified=0
    for image in "$@"; do
        test -f "$image" || continue
        test "$(head -c 7 "$image" | tr -d '\000')" = imagefs || continue
        length=$(wc -c < "$image" | tr -d ' ')
        fsimg_verify "$image" 0 "$length" "$fixture/verify" || continue
        verified=$((verified + 1))
        if test -n "$dumpifs" &&
            ! oracle_accepts "$dumpifs" "$image"; then
            fail "dumpifs refuses $(basename "$image"), which fsimg verifies"
        fi
        if test -n "$probe" &&
            ! oracle_accepts "$probe" "$image"; then
            fail "qnxprobe refuses $(basename "$image"), which fsimg verifies"
        fi
    done
    test -z "$dumpifs" ||
        echo "dumpifs accepts the $verified images fsimg verifies"
    test -z "$probe" ||
        echo "qnxprobe accepts the $verified images fsimg verifies"
}

# Fails unless the comparison's output holds a line matching pattern $1.
expect_line() {
    grep -q "$1" "$fixture/compare" ||
        fail "the generated images' comparison lacks the line $1"
}

dumpifs=${DUMPIFS:-}
probe=${QNXPROBE:-}

# Two generated images, verified through the command and, as a test of the
# comparison itself, compared with ifsdump.py: the fuzzing seed, whose
# names outside the profile are omitted with their subtrees, a link, a
# FIFO among them, implicit parents inside and outside an omitted subtree
# and a boot reference; and an image of shadowed records, duplicates and
# paths below a file, a link and a link that shadows a directory.
./test-ifs --seed "$fixture/omitted.ifs"
./test-ifs --seed-shadowed "$fixture/shadowed.ifs"
for image in "$fixture/omitted.ifs" "$fixture/shadowed.ifs"; do
    length=$(wc -c < "$image" | tr -d ' ')
    fsimg_verify "$image" 0 "$length" "$fixture/verify" ||
        fail "the generated $(basename "$image") does not verify"
done

# A generated hbcifs container and the ImageFS it decodes to: i reports the
# stack, the codec and the header fields, and W -d passes, naming the two
# fields no rule checks and calling the verification incomplete.
./test-hbcifs --seed-hbcifs "$fixture/seed.hbcifs" "$fixture/seed.imagefs"
./fsimg i --json -f "$fixture/seed.hbcifs" > "$fixture/info" 2> /dev/null ||
    fail "fsimg i failed on the generated hbcifs container"
grep -q '"stack":"ifs/hbcifs".*"container_codecs":"lzo1x".*"container_details":{"decoded_bytes":"[0-9]*","payload_bytes"' \
    "$fixture/info" || fail "the generated container is not read as ifs/hbcifs"
./fsimg W --json -d -f "$fixture/seed.hbcifs" > "$fixture/verify" \
    2> /dev/null || fail "the generated hbcifs container does not verify"
grep -q '"type":"verify","complete":false,.*"container":"hbcifs","unverified":"0x14,0x1c"' \
    "$fixture/verify" ||
    fail "the generated container's verification does not name its unverified fields"
if test -n "$python"; then
    result=0
    "$python" -I "$native_tool" compare ./fsimg ./test-ifs "$ifsdump" \
        "$fixture/omitted.ifs" "$fixture/shadowed.ifs" > "$fixture/compare" ||
        result=$?
    cat "$fixture/compare"
    test "$result" = 0 ||
        fail "fsimg differs from ifsdump.py on the generated images"
    # Both must open, with the counts the generator builds in, so that the
    # comparison's rules stay exercised.
    expect_line '^compare: 2 images, 0 refused,'
    expect_line '^omitted.ifs: .* 4 implicit directories, 0 shadowed records, 6 omitted subtrees$'
    expect_line '^shadowed.ifs: .* 2 implicit directories, 5 shadowed records, 0 omitted subtrees$'
    # The container comparison on the generated hbcifs container and the
    # ImageFS it decodes to, and, as a seeded failure, against another
    # image's decode.
    "$python" -I "$native_tool" container ./fsimg ./test-ifs "$ifsdump" \
        "$fixture/seed.hbcifs" "$fixture/seed.imagefs" > "$fixture/compare" ||
        fail "fsimg differs from ifsdump.py on the generated container"
    cat "$fixture/compare"
    expect_line '^seed.hbcifs: 2 entries, 1 files. bytes, 1 link targets, .*; extracted 1 files and 0 directories$'
    if "$python" -I "$native_tool" container ./fsimg ./test-ifs "$ifsdump" \
        "$fixture/seed.hbcifs" "$fixture/omitted.ifs" > /dev/null; then
        fail "the container comparison accepts another image's decode"
    fi
    ran=1
else
    echo 'SKIP: the ifsdump.py comparison requires the Python 3 development tool'
fi
if test -n "$dumpifs" || test -n "$probe"; then
    oracle_compare "$fixture/omitted.ifs" "$fixture/shadowed.ifs"
    ran=1
fi

# The listing's entry records of image $1 into file $2, without the stack
# and info records, which name the layers.
entry_records() {
    ./fsimg t --json -f "$1" 2> /dev/null | grep '"type":"entry"' > "$2"
}

# Each generated boot image reads as its bare body: the same entry records
# and extracted tree (the link, which safe extraction does not create, is
# skipped), verified with read-through under the ifsboot stack.
mkdir -m 0700 "$fixture/boot" "$fixture/boot-body"
./test-ifsboot --emit "$fixture/boot"
entry_records "$fixture/boot/body.imagefs" "$fixture/boot-body.entries" ||
    fail "fsimg t failed on the generated body"
./fsimg x -E -k -C "$fixture/boot-body" -f "$fixture/boot/body.imagefs" \
    > /dev/null 2>&1 || fail "fsimg x failed on the generated body"
boot_images=0
for image in "$fixture/boot"/*.ifs; do
    name=$(basename "$image")
    ./fsimg i --json -f "$image" > "$fixture/info" 2> /dev/null ||
        fail "fsimg i failed on $name"
    grep -q '"stack":"ifs/ifsboot"' "$fixture/info" ||
        fail "$name is not read through the ifsboot container"
    # The startup header's fields: the machine and its prefix tell the
    # x86 images, behind the BIOS loader, from the SH-4 ones.
    case $name in
    bios-*) machine=3 prefix=1088 ;;
    *) machine=42 prefix=0 ;;
    esac
    grep -q '"container_details":{"prefix_bytes":"'"$prefix"'",.*"machine":"'"$machine"'",' \
        "$fixture/info" || fail "$name reports other header fields"
    ./fsimg i -f "$image" 2> /dev/null |
        grep -q "^machine: $(printf '0x%08x' "$machine")\$" ||
        fail "$name prints other header fields"
    boot_verify "$image" "$fixture/verify" || fail "$name does not verify"
    entry_records "$image" "$fixture/boot.entries" ||
        fail "fsimg t failed on $name"
    cmp -s "$fixture/boot.entries" "$fixture/boot-body.entries" ||
        fail "$name lists differently from its body"
    rm -rf "$fixture/boot-tree"
    mkdir -m 0700 "$fixture/boot-tree"
    ./fsimg x -E -k -C "$fixture/boot-tree" -f "$image" > /dev/null 2>&1 ||
        fail "fsimg x failed on $name"
    diff -r "$fixture/boot-tree" "$fixture/boot-body" > /dev/null ||
        fail "$name extracts differently from its body"
    boot_images=$((boot_images + 1))
done
test "$boot_images" = 6 || fail "test-ifsboot emitted $boot_images boot images"
echo "generated boot images: $boot_images list, extract and verify as their body"
ran=1

native=${FSIMG_IFS_NATIVE:-}
if test -n "$native"; then
    ./test-ifs --native || fail "test-ifs --native"
    ./test-ifsboot --native || fail "test-ifsboot --native"
    set --
    for group in cases/ifs-basic cases/ifs-names cases/ifs-extra \
        cases/ifs-data decoded; do
        for image in "$native/$group"/*; do
            if test -f "$image"; then
                set -- "$@" "$image"
            fi
        done
    done
    test "$#" != 0 || fail "$native holds no captures"
    if test -n "$python"; then
        "$python" -I "$native_tool" compare ./fsimg ./test-ifs "$ifsdump" \
            "$@" || fail "fsimg differs from ifsdump.py on the native captures"
    fi
    if test -n "$dumpifs" || test -n "$probe"; then
        oracle_compare "$@"
    fi
    ran=1
else
    echo 'SKIP: FSIMG_IFS_NATIVE is not set (QNX 6.5.0 captures)'
fi
test -n "$dumpifs" || echo 'SKIP: DUMPIFS is not set (lclevy/dumpifs comparison)'
test -n "$probe" || echo 'SKIP: QNXPROBE is not set (qnxprobe comparison)'

# The hbcifs container, read through its layers; only counts and the
# image's file name are printed.
hbcifs=${FSIMG_HBCIFS_IMAGE:-}
hbcifs_decoded=${FSIMG_HBCIFS_DECODED:-}
if test -z "$hbcifs" || test -z "$hbcifs_decoded"; then
    echo 'SKIP: FSIMG_HBCIFS_IMAGE and FSIMG_HBCIFS_DECODED are not set' \
        '(PCM3_IFS2.ifs and its oracle decode)'
elif test -z "$python"; then
    echo 'SKIP: the hbcifs comparison requires the Python 3 development tool'
else
    name=$(basename "$hbcifs")
    ./fsimg i --json -f "$hbcifs" > "$fixture/info" 2> /dev/null ||
        fail "fsimg i failed on $name"
    grep -q '"stack":"ifs/hbcifs".*"container_codecs":"lzo1x"' \
        "$fixture/info" || fail "$name is not read as ifs/hbcifs"
    disk=$(./test-hbcifs --cksum "$hbcifs") ||
        fail "the library cannot decode $name"
    oracle=$(cksum < "$hbcifs_decoded" | awk '{ print $1, $2 }')
    test "$disk" = "$oracle" ||
        fail "the disk decoded from $name differs from the oracle's decode"
    "$python" -I "$native_tool" container ./fsimg ./test-ifs "$ifsdump" \
        "$hbcifs" "$hbcifs_decoded" ||
        fail "fsimg differs from ifsdump.py on $name"
    ./fsimg W --json -d -f "$hbcifs" > "$fixture/verify" 2> /dev/null ||
        fail "$name does not verify"
    grep -q '"type":"verify","complete":false,' "$fixture/verify" &&
        grep -q '"container":"hbcifs","unverified":"0x14,0x1c"' \
        "$fixture/verify" ||
        fail "the verification of $name does not name its unverified fields"
    status=0
    ./fsimg t --json -l spool=1M -f "$hbcifs" > "$fixture/limit" \
        2> /dev/null || status=$?
    test "$status" = 1 &&
        grep -q '"type":"error".*"resource":"spool"' "$fixture/limit" ||
        fail "$name is read under a 1 MiB spool limit"
    # The step that crosses the limit fails, one 64 KiB window past it.
    observed=$(sed -n 's/.*"type":"error".*"observed":"\([0-9]*\)".*/\1/p' \
        "$fixture/limit")
    test -n "$observed" && test "$observed" -gt 1048576 &&
        test "$observed" -le $((1048576 + 65536)) ||
        fail "$name does not fail at the step crossing the spool limit"
    echo "$name: decodes to the oracle's $(echo "$disk" | cut -d ' ' -f 2)" \
        "bytes; verified with fields 0x14 and 0x1c unverified; refused" \
        "under a 1 MiB spool limit"
    ran=1
fi

# The licensed images, read in place through info and verification with
# payload read-through alone, which reads every file; only counts and the
# images' file names are printed. A compressed boot image is read whole,
# its body decoded through the ifsboot container.
images=${FSIMG_IFS_IMAGES:-}
if test -n "$images" && test -z "$python"; then
    echo 'SKIP: FSIMG_IFS_IMAGES requires the Python 3 development tool'
elif test -n "$images"; then
    read_bodies=0
    read_boot=0
    other=0
    for image in "$images"/*; do
        test -f "$image" || continue
        name=$(basename "$image")
        bounds=$("$python" -I "$native_tool" body "$image") ||
            fail "cannot read $name"
        case $bounds in
        compressed\ *)
            boot_verify "${bounds#compressed }" "$fixture/verify" ||
                fail "$name does not verify as a boot image"
            files=$(verify_count files "$fixture/verify")
            read_bytes=$(verify_count initialized_bytes_read "$fixture/verify")
            echo "$name: boot image verified, $files files, $read_bytes" \
                "bytes read"
            read_boot=$((read_boot + 1))
            continue
            ;;
        none)
            other=$((other + 1))
            continue
            ;;
        esac
        # "OFFSET LENGTH PATH", the path last since it may hold blanks.
        offset=${bounds%% *}
        bounds=${bounds#* }
        length=${bounds%% *}
        body_file=${bounds#* }
        ./fsimg i --json --offset="$offset" --length="$length" \
            -f "$body_file" > "$fixture/info" 2> /dev/null ||
            fail "fsimg i failed on $name"
        grep -q '"format":"ifs"' "$fixture/info" ||
            fail "$name is not read as an ImageFS"
        fsimg_verify "$body_file" "$offset" "$length" "$fixture/verify" ||
            fail "$name does not verify"
        directories=$(verify_count directories "$fixture/verify")
        files=$(verify_count files "$fixture/verify")
        read_bytes=$(verify_count initialized_bytes_read "$fixture/verify")
        echo "$name: verified, $directories directories with the root and" \
            "$files other entries, $read_bytes bytes read"
        read_bodies=$((read_bodies + 1))
    done
    if test "$other" != 0; then
        echo "$other files in FSIMG_IFS_IMAGES are neither an ImageFS nor a" \
            "little-endian boot image"
    fi
    if test "$read_bodies" = 0 && test "$read_boot" = 0; then
        echo 'SKIP: FSIMG_IFS_IMAGES holds no boot image or ImageFS'
    else
        ran=1
    fi
else
    echo 'SKIP: FSIMG_IFS_IMAGES is not set (S1 and S2 images, counts only)'
fi

if test "$ran" = 0; then
    exit 77
fi
