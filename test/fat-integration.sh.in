#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Stanislav Sedov <stas@deglitch.com>
set -eu
MKFS_FAT='@MKFS_FAT@'
FSCK_FAT='@FSCK_FAT@'
NEWFS_MSDOS='@NEWFS_MSDOS@'
FSCK_MSDOSFS='@FSCK_MSDOSFS@'
MCOPY='@MCOPY@'
MMD='@MMD@'
MDEL='@MDEL@'
FATCAT='@FATCAT@'
host=$(uname -s)
for tool in "$MCOPY" "$MMD" "$MDEL"; do
    if test -z "$tool"; then
        echo 'SKIP: independent FAT tests require mtools'
        exit 77
    fi
done

if test "$host" != Linux && test -z "$FATCAT"; then
    echo 'SKIP: macOS and FreeBSD FAT tests require the pinned fatcat oracle'
    exit 77
fi

# fatcat checks are scoped to macOS/FreeBSD. The other independent tools still
# validate Linux fixtures. Every pair below names an image path and expected
# host content; an empty list requests volume information only.
check_fatcat()
{
    checked_image=$1
    checked_sector=$2
    shift 2
    if test "$host" = Linux; then
        echo 'SKIP: fatcat checks are scoped to macOS and FreeBSD'
        return
    fi
    if test "$checked_sector" != 512; then
        echo 'SKIP: fatcat does not support non-512-byte sectors'
        return
    fi
    "$FATCAT" -i "$checked_image"
    if test "$#" != 0; then
        "$FATCAT" -l /Nested "$checked_image"
    fi
    while test "$#" != 0; do
        "$FATCAT" -r "$1" "$checked_image" > "$fixture_dir/fatcat-payload"
        cmp "$2" "$fixture_dir/fatcat-payload"
        shift 2
    done
    echo 'result: fatcat selected content comparisons passed'
}

# Each host uses its own independent formatter/checker pair. Population and
# content comparison use mtools for both, with identical fixture geometry.
if test "$(uname -s)" = FreeBSD; then
    formatter=$NEWFS_MSDOS
    checker=$FSCK_MSDOSFS
else
    formatter=$MKFS_FAT
    checker=$FSCK_FAT
fi
if test -z "$formatter" || test -z "$checker"; then
    echo 'SKIP: independent FAT tests require the host formatter/checker pair'
    exit 77
fi

format_image()
{
    if test "$(uname -s)" = FreeBSD; then
        # File geometry otherwise counts 512-byte sectors even with -S 4096.
        sectors=$((kib * 1024 / sector))
        # Ignore metadata overhead for a conservative cluster-count bound.
        # Include both reserved entries so the formatter's table always has
        # capacity for the geometry it advertises, including FAT32 boundaries.
        fat_sectors=$((( (sectors / spc + 2) * variant + 8 * sector - 1) / (8 * sector)))
        echo "create: newfs_msdos -C ${kib}K -F $variant -S $sector -s $sectors -a $fat_sectors -c $spc -L FSIMGTEST -T 315532800 image"
        "$formatter" -C "${kib}K" -F "$variant" -S "$sector" \
            -s "$sectors" -a "$fat_sectors" -c "$spc" \
            -L FSIMGTEST -T 315532800 "$image"
    else
        echo "create: mkfs.fat --invariant -F $variant -S $sector -s $spc -n FSIMGTEST -C image $kib"
        "$formatter" --invariant -F "$variant" -S "$sector" \
            -s "$spc" -n FSIMGTEST -C "$image" "$kib"
    fi
}

fixture_dir=$(mktemp -d fat-interop-XXXXXX)
trap 'rm -rf "$fixture_dir"' 0
trap 'exit 1' 1 2 15
printf 'Independent FAT fixture.\n' > "$fixture_dir/payload"
unicode_name=$(printf 'R\303\251sum\303\251 collection.txt')

# Each log is the fixture manifest: formatter/validator versions, geometry,
# population commands and the independent validator's outcome. No imported
# binary fixtures or third-party implementation code are distributed.
echo "formatter: $formatter; checker: $checker; host: $(uname -sr)"
if test "$(uname -s)" != FreeBSD; then
    "$formatter" --help 2>&1 | sed -n '1p'
fi
"$MCOPY" -V
if test "$host" != Linux; then
    "$FATCAT" -h 2>&1 | sed -n '1p'
fi
for profile in fat12 fat16 fat32 fat16-wide; do
    sector=512
    spc=1
    case "$profile" in
    fat12) variant=12; kib=1440 ;;
    fat16) variant=16; kib=16384 ;;
    fat32) variant=32; kib=65536 ;;
    fat16-wide) variant=16; kib=65536; sector=4096; spc=2 ;;
    esac
    image="$fixture_dir/$profile.img"
    echo "fixture: FAT$variant; $kib KiB; $sector-byte sectors; $spc sectors/cluster"
    format_image
    echo 'populate: mcopy Hello.txt, Unicode long name; mmd Nested; mcopy Nested/Deep.txt'
    "$MCOPY" -i "$image" "$fixture_dir/payload" ::Hello.txt
    "$MCOPY" -i "$image" "$fixture_dir/payload" "::$unicode_name"
    "$MMD" -i "$image" ::Nested
    "$MCOPY" -i "$image" "$fixture_dir/payload" ::Nested/Deep.txt
    if test "$profile" = fat12; then
        # Leave a 400 KiB hole and a tail shorter than 600 KiB. The new file
        # must span both, independently forcing a fragmented allocation chain.
        ./test-fat --make-payload "$fixture_dir/filler" 409600
        ./test-fat --make-payload "$fixture_dir/fragment" 614400
        for name in A B C; do
            "$MCOPY" -i "$image" "$fixture_dir/filler" "::$name.BIN"
        done
        "$MDEL" -i "$image" ::B.BIN
        "$MCOPY" -i "$image" "$fixture_dir/fragment" ::FRAG.BIN
        "$MDEL" -i "$image" ::A.BIN ::C.BIN
        echo 'fragment: three 400 KiB fillers, delete middle, copy 600 KiB, delete remaining fillers'
    fi
    "$checker" -n "$image"
    if test "$profile" = fat12; then
        check_fatcat "$image" "$sector" /Hello.txt "$fixture_dir/payload" \
            /Nested/Deep.txt "$fixture_dir/payload" /FRAG.BIN "$fixture_dir/fragment"
    else
        check_fatcat "$image" "$sector" /Hello.txt "$fixture_dir/payload" \
            /Nested/Deep.txt "$fixture_dir/payload"
    fi
    ./test-fat --external "$image" "fat$variant"
    echo 'result: independent checker and fsimg enumeration/content/full verification passed'
done

# fsimg-created volumes are checked and extracted by independent tools. These
# checks do not rely on fsimg's decoder to judge its own directory/FAT output.
printf 'Independent FAT writer fixture.\n' > "$fixture_dir/writer-payload"
for profile in fat12 fat16 fat32; do
    mkdir "$fixture_dir/write-$profile"
    ./test-fat-write --create "$fixture_dir/write-$profile" "$profile"
    image="$fixture_dir/write-$profile/writer.img"
    echo "writer fixture: $profile; automatic geometry; serial zero; NO NAME label"
    "$checker" -n "$image"
    check_fatcat "$image" 512 /HELLO.TXT "$fixture_dir/writer-payload" \
        '/Nested/long name.txt' "$fixture_dir/writer-payload"
    "$MCOPY" -i "$image" ::HELLO.TXT "$fixture_dir/extracted"
    cmp "$fixture_dir/writer-payload" "$fixture_dir/extracted"
    rm "$fixture_dir/extracted"
    "$MCOPY" -i "$image" '::Nested/long name.txt' "$fixture_dir/extracted"
    cmp "$fixture_dir/writer-payload" "$fixture_dir/extracted"
    rm "$fixture_dir/extracted"
    "$MCOPY" -i "$image" "::$unicode_name" "$fixture_dir/extracted"
    cmp "$fixture_dir/writer-payload" "$fixture_dir/extracted"
    rm "$fixture_dir/extracted"
    echo 'result: checker and mtools Unicode/long-name extraction passed'
    rm "$image"
    ./test-fat-write --create-empty "$fixture_dir/write-$profile" "$profile"
    "$checker" -n "$image"
    check_fatcat "$image" 512
    echo 'result: independently checked empty writer volume'
done
