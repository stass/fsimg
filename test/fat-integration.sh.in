#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Stanislav Sedov <stas@deglitch.com>
set -eu
MKFS_FAT='@MKFS_FAT@'
FSCK_FAT='@FSCK_FAT@'
NEWFS_MSDOS='@NEWFS_MSDOS@'
FSCK_MSDOSFS='@FSCK_MSDOSFS@'
MDIR='@MDIR@'
MCOPY='@MCOPY@'
MMD='@MMD@'
MDEL='@MDEL@'
FATCAT='@FATCAT@'
host=$(uname -s)
for tool in "$MCOPY" "$MMD" "$MDEL" "$MDIR"; do
    if test -z "$tool"; then
        echo 'SKIP: independent FAT tests require mtools'
        exit 77
    fi
done

if test "$host" != Linux && test -z "$FATCAT"; then
    echo 'SKIP: macOS and FreeBSD FAT tests require the pinned fatcat oracle'
    exit 77
fi

# fatcat checks are scoped to macOS/FreeBSD. The other independent tools still
# validate Linux fixtures. The third argument names the directory fatcat
# lists before the comparisons. Every pair after it names an image path and
# expected host content; an empty list requests volume information only.
check_fatcat()
{
    checked_image=$1
    checked_sector=$2
    checked_listing=$3
    shift 3
    if test "$host" = Linux; then
        echo 'SKIP: fatcat checks are scoped to macOS and FreeBSD'
        return
    fi
    if test "$checked_sector" != 512; then
        echo 'SKIP: fatcat does not support non-512-byte sectors'
        return
    fi
    "$FATCAT" -i "$checked_image"
    if test "$#" != 0; then
        "$FATCAT" -l "$checked_listing" "$checked_image"
    fi
    while test "$#" != 0; do
        "$FATCAT" -r "$1" "$checked_image" > "$fixture_dir/fatcat-payload"
        cmp "$2" "$fixture_dir/fatcat-payload"
        shift 2
    done
    echo 'result: fatcat selected content comparisons passed'
}

# Each host uses its own independent formatter/checker pair. Population and
# content comparison use mtools for both, with identical fixture geometry.
if test "$(uname -s)" = FreeBSD; then
    formatter=$NEWFS_MSDOS
    checker=$FSCK_MSDOSFS
else
    formatter=$MKFS_FAT
    checker=$FSCK_FAT
fi
if test -z "$formatter" || test -z "$checker"; then
    echo 'SKIP: independent FAT tests require the host formatter/checker pair'
    exit 77
fi

check_volume()
{
    volume_size=$(wc -c < "$1")
    if test "$volume_size" -lt 4096; then
        # fsck_msdosfs reads a 4096-byte boot block even for smaller volumes.
        # Zero padding lies beyond the volume's recorded sector count.
        padded_image="$fixture_dir/check-volume.img"
        cp "$1" "$padded_image"
        dd if=/dev/zero bs=1 count=$((4096 - volume_size)) \
            >> "$padded_image" 2>/dev/null
        checker_status=0
        "$checker" -n "$padded_image" || checker_status=$?
        rm -f "$padded_image"
        return "$checker_status"
    fi
    "$checker" -n "$1"
}

format_image()
{
    if test "$(uname -s)" = FreeBSD; then
        # File geometry otherwise counts 512-byte sectors even with -S 4096.
        sectors=$((kib * 1024 / sector))
        # Ignore metadata overhead for a conservative cluster-count bound.
        # Include both reserved entries so the formatter's table always has
        # capacity for the geometry it advertises, including FAT32 boundaries.
        fat_sectors=$((( (sectors / spc + 2) * variant + 8 * sector - 1) / (8 * sector)))
        echo "create: newfs_msdos -C ${kib}K -F $variant -S $sector -s $sectors -a $fat_sectors -c $spc -L FSIMGTEST -T 315532800 image"
        "$formatter" -C "${kib}K" -F "$variant" -S "$sector" \
            -s "$sectors" -a "$fat_sectors" -c "$spc" \
            -L FSIMGTEST -T 315532800 "$image"
    else
        echo "create: mkfs.fat --invariant -F $variant -S $sector -s $spc -n FSIMGTEST -C image $kib"
        "$formatter" --invariant -F "$variant" -S "$sector" \
            -s "$spc" -n FSIMGTEST -C "$image" "$kib"
    fi
}

fixture_dir=$(mktemp -d fat-interop-XXXXXX)
trap 'rm -rf "$fixture_dir"' 0
trap 'exit 1' 1 2 15
printf 'Independent FAT fixture.\n' > "$fixture_dir/payload"
unicode_name=$(printf 'R\303\251sum\303\251 collection.txt')
# mtools uses the locale charset to convert host names to UCS-2.
if ! available_locales=$(locale -a); then
    echo 'ERROR: locale -a failed' >&2
    exit 1
fi
utf8_locale=$(printf '%s\n' "$available_locales" | awk '
    /^C\.(UTF-8|utf8)$/ { preferred = $0 }
    /\.(UTF-8|utf8)(@[^@]+)?$/ { if (fallback == "") fallback = $0 }
    END { print (preferred != "" ? preferred : fallback) }
')
external_mode=--external
if test -z "$utf8_locale"; then
    echo 'SKIP: Unicode-name populate/extract checks require a UTF-8 locale (locale -a found none)'
    external_mode=--external-ascii
fi

# Each log is the fixture manifest: formatter/validator versions, geometry,
# population commands and the independent validator's outcome. No imported
# binary fixtures or third-party implementation code are distributed.
echo "formatter: $formatter; checker: $checker; host: $(uname -sr)"
if test "$(uname -s)" != FreeBSD; then
    "$formatter" --help 2>&1 | sed -n '1p'
fi
echo "mtools locale: ${utf8_locale:-C (Unicode checks skipped)}"
LC_ALL=${utf8_locale:-C} "$MCOPY" -V
if test "$host" != Linux; then
    "$FATCAT" -h 2>&1 | sed -n '1p'
fi
for profile in fat12 fat16 fat32 fat16-wide; do
    sector=512
    spc=1
    case "$profile" in
    fat12) variant=12; kib=1440 ;;
    fat16) variant=16; kib=16384 ;;
    fat32) variant=32; kib=65536 ;;
    fat16-wide) variant=16; kib=65536; sector=4096; spc=2 ;;
    esac
    image="$fixture_dir/$profile.img"
    echo "fixture: FAT$variant; $kib KiB; $sector-byte sectors; $spc sectors/cluster"
    format_image
    echo 'populate: mcopy Hello.txt; mmd Nested; mcopy Nested/Deep.txt'
    LC_ALL=${utf8_locale:-C} "$MCOPY" -i "$image" "$fixture_dir/payload" ::Hello.txt
    if test -n "$utf8_locale"; then
        echo 'populate: mcopy Unicode long name'
        LC_ALL=$utf8_locale "$MCOPY" -i "$image" "$fixture_dir/payload" "::$unicode_name"
    fi
    LC_ALL=${utf8_locale:-C} "$MMD" -i "$image" ::Nested
    LC_ALL=${utf8_locale:-C} "$MCOPY" -i "$image" "$fixture_dir/payload" ::Nested/Deep.txt
    if test "$profile" = fat12; then
        # Leave a 400 KiB hole and a tail shorter than 600 KiB. The new file
        # must span both, independently forcing a fragmented allocation chain.
        ./test-fat --make-payload "$fixture_dir/filler" 409600
        ./test-fat --make-payload "$fixture_dir/fragment" 614400
        for name in A B C; do
            LC_ALL=${utf8_locale:-C} "$MCOPY" -i "$image" "$fixture_dir/filler" "::$name.BIN"
        done
        LC_ALL=${utf8_locale:-C} "$MDEL" -i "$image" ::B.BIN
        LC_ALL=${utf8_locale:-C} "$MCOPY" -i "$image" "$fixture_dir/fragment" ::FRAG.BIN
        LC_ALL=${utf8_locale:-C} "$MDEL" -i "$image" ::A.BIN ::C.BIN
        echo 'fragment: three 400 KiB fillers, delete middle, copy 600 KiB, delete remaining fillers'
    fi
    check_volume "$image"
    if test "$profile" = fat12; then
        check_fatcat "$image" "$sector" /Nested /Hello.txt "$fixture_dir/payload" \
            /Nested/Deep.txt "$fixture_dir/payload" /FRAG.BIN "$fixture_dir/fragment"
    else
        check_fatcat "$image" "$sector" /Nested /Hello.txt "$fixture_dir/payload" \
            /Nested/Deep.txt "$fixture_dir/payload"
    fi
    ./test-fat "$external_mode" "$image" "fat$variant"
    echo 'result: independent checker and fsimg enumeration/content/full verification passed'
done

# The pinned large-file catalogs choose different clusters under -M. Check
# their FAT/root layout and extract both files without fsimg's decoder.
for profile in fat12 fat16 fat32; do
    mkdir "$fixture_dir/minimize-$profile"
    ./test-fat-write --create-minimized "$fixture_dir/minimize-$profile" "$profile"
    image="$fixture_dir/minimize-$profile/writer.img"
    expected="$fixture_dir/minimize-$profile/payload"
    check_volume "$image"
    check_fatcat "$image" 512 / /F0000000 "$expected" /F0000001 "$expected"
    for name in F0000000 F0000001; do
        LC_ALL=${utf8_locale:-C} "$MCOPY" -i "$image" "::$name" "$fixture_dir/minimized-payload"
        cmp "$expected" "$fixture_dir/minimized-payload"
        rm "$fixture_dir/minimized-payload"
    done
    echo "result: minimized $profile passed checker and independent content comparisons"
done

# fsimg-created volumes are checked and extracted by independent tools. These
# checks do not rely on fsimg's decoder to judge its own directory/FAT output.
printf 'Independent FAT writer fixture.\n' > "$fixture_dir/writer-payload"
for profile in fat12 fat16 fat32; do
    mkdir "$fixture_dir/write-$profile"
    ./test-fat-write --create "$fixture_dir/write-$profile" "$profile"
    image="$fixture_dir/write-$profile/writer.img"
    echo "writer fixture: $profile; automatic geometry; serial zero; NO NAME label"
    check_volume "$image"
    check_fatcat "$image" 512 /Nested /HELLO.TXT "$fixture_dir/writer-payload" \
        '/Nested/long name.txt' "$fixture_dir/writer-payload"
    LC_ALL=${utf8_locale:-C} "$MCOPY" -i "$image" ::HELLO.TXT "$fixture_dir/extracted"
    cmp "$fixture_dir/writer-payload" "$fixture_dir/extracted"
    rm "$fixture_dir/extracted"
    LC_ALL=${utf8_locale:-C} "$MCOPY" -i "$image" '::Nested/long name.txt' "$fixture_dir/extracted"
    cmp "$fixture_dir/writer-payload" "$fixture_dir/extracted"
    rm "$fixture_dir/extracted"
    if test -n "$utf8_locale"; then
        LC_ALL=$utf8_locale "$MCOPY" -i "$image" "::$unicode_name" "$fixture_dir/extracted"
        cmp "$fixture_dir/writer-payload" "$fixture_dir/extracted"
        rm "$fixture_dir/extracted"
        echo 'result: mtools Unicode-name extraction passed'
    fi
    echo 'result: checker and mtools long-name extraction passed'
    rm "$image"
    ./test-fat-write --create-empty "$fixture_dir/write-$profile" "$profile"
    check_volume "$image"
    check_fatcat "$image" 512 /
    echo 'result: independently checked empty writer volume'
done

# The fixed root has 32 slots: the label and SEED.TXT consume two. Empty
# 8.3 files consume one slot each and no data clusters, so failure on the
# 31st copy measures the directory capacity independently of fsimg's reader.
: > "$fixture_dir/root-empty"
for profile in fat12 fat16; do
    mkdir "$fixture_dir/root-$profile"
    ./test-fat-write --create-fixed-root "$fixture_dir/root-$profile" "$profile"
    image="$fixture_dir/root-$profile/writer.img"
    check_volume "$image"
    LC_ALL=C MTOOLS_SKIP_CHECK=1 "$MDIR" -i "$image" ::
    if test "$host" != Linux; then
        "$FATCAT" -l / "$image"
    fi
    slot=1
    while test "$slot" -le 30; do
        name=$(printf 'F%07d' "$slot")
        LC_ALL=C MTOOLS_SKIP_CHECK=1 "$MCOPY" -i "$image" \
            "$fixture_dir/root-empty" "::$name"
        slot=$((slot + 1))
    done
    if LC_ALL=C MTOOLS_SKIP_CHECK=1 "$MCOPY" -i "$image" \
        "$fixture_dir/root-empty" ::OVERFLOW > "$fixture_dir/root-full.log" 2>&1; then
        echo "ERROR: $profile accepted a 33rd fixed-root entry" >&2
        exit 1
    fi
    cat "$fixture_dir/root-full.log"
    if ! grep -F 'No directory slots' "$fixture_dir/root-full.log"; then
        echo "ERROR: $profile overflow did not report exhausted directory slots" >&2
        exit 1
    fi
    LC_ALL=C MTOOLS_SKIP_CHECK=1 "$MDIR" -i "$image" ::F0000030
    check_volume "$image"
    echo "result: minimized $profile has exactly 32 independently filled root slots"
done
