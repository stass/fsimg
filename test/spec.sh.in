#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026, fsimg contributors
#
# Runs the specification-driven test harness (specs/design-spec-testing.md):
#
#   test/spec.sh [PROFILE]
#   test/spec.sh --replay=CASE.json [PROFILE]
#
# The profile is quick when none is given, as under make check. --replay
# rebuilds and reruns one case from its recipe, such as a failure record's
# case.json, under the profile's ceilings, with bin/replay. The script
# exits 77 when Ruby 3.2 is absent, and run.rb does when a locked gem is.
# A replay's status is for git bisect run: 0 good, 3 bad, 125 untestable,
# which a missing Ruby or gem is too, and 128, which stops the bisection,
# for anything else, such as a usage error or a crash of the harness.
set -eu
# Exits 2, or 128 when the first argument asks for a replay.
usage() {
    echo 'usage: test/spec.sh [PROFILE | --replay=CASE.json [PROFILE]]' >&2
    case ${1:-} in --replay=*) exit 128 ;; esac
    exit 2
}
case $# in
0 | 1) ;;
2) case $1 in --replay=*) ;; *) usage "$1" ;; esac ;;
*) usage "$1" ;;
esac
# run.rb loads the locked bundle itself. An inherited Ruby or bundle
# environment, such as another project's bundle exec, would change what the
# interpreter loads first.
unset RUBYOPT RUBYLIB BUNDLER_VERSION
ruby='@RUBY@'
spec='@abs_top_srcdir@/test/spec'
profile=${1:-quick}
skip=77
case $profile in --replay=*) skip=125 ;; esac
if test -z "$ruby" ||
    ! "$ruby" -e 'exit(Gem::Version.new(RUBY_VERSION) >= Gem::Version.new("3.2"))'; then
    echo "SKIP: specification tests require Ruby 3.2 or later (configured: ${ruby:-none})"
    exit $skip
fi
BUNDLE_GEMFILE="$spec/Gemfile"
FSIMG_BUILDDIR='@abs_top_builddir@'
FSIMG_BIN="$FSIMG_BUILDDIR/fsimg"
MKFS_FAT='@MKFS_FAT@'
FSCK_FAT='@FSCK_FAT@'
NEWFS_MSDOS='@NEWFS_MSDOS@'
FSCK_MSDOSFS='@FSCK_MSDOSFS@'
MCOPY='@MCOPY@'
MMD='@MMD@'
MDEL='@MDEL@'
MDIR='@MDIR@'
FATCAT='@FATCAT@'
export BUNDLE_GEMFILE FSIMG_BUILDDIR FSIMG_BIN MKFS_FAT FSCK_FAT NEWFS_MSDOS \
    FSCK_MSDOSFS MCOPY MMD MDEL MDIR FATCAT
case $profile in
--replay=*)
    status=0
    "$ruby" "$spec/bin/replay" "${profile#--replay=}" ${2+"$2"} || status=$?
    case $status in
    0 | 3 | 125) ;;
    77) status=125 ;;
    *) status=128 ;;
    esac
    exit "$status"
    ;;
esac
exec "$ruby" "$spec/run.rb" --profile="$profile"
