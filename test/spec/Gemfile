# frozen_string_literal: true

# Development gems of the specification-driven test harness. Gemfile.lock
# pins them; run.rb loads them with Bundler's frozen setting, so a test run
# never rewrites the lock or reaches the network.
source "https://rubygems.org"

gem "bindata", "~> 3.0"
gem "minitest", "~> 6.0"
gem "prop_check", "~> 1.0"
