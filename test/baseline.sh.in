#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Stanislav Sedov <stas@deglitch.com>
#
# Compare the comparison-baseline fixtures with the checked-in baseline.
# Each test program's --baseline mode prints one record per fixture:
#   fixture=<name> key=value ...
# With --record, print the sorted current records instead of comparing; the
# baseline-record make target writes them to test/baseline.txt. This script
# never writes the baseline itself.
set -eu
LC_ALL=C
export LC_ALL
baseline='@abs_top_srcdir@/test/baseline.txt'
work=$(mktemp -d "${TMPDIR:-/tmp}/fsimg-baseline-XXXXXX")
trap 'rm -rf "$work"' EXIT
trap 'exit 1' HUP INT TERM

for program in test-fat test-fat-write test-exfat; do
    if ! "./$program" --baseline >"$work/$program.records"; then
        echo "FAIL: $program --baseline did not complete"
        exit 1
    fi
done
# One line per fixture, sorted by name (LC_ALL=C), so the order is stable
# across hosts and independent of which program prints which fixture.
sort "$work"/*.records >"$work/current"
if test "${1:-}" = --record; then
    cat "$work/current"
    exit 0
fi

awk '
# The one place that classifies keys. Semantic keys must match the baseline
# exactly. Every other key is a resource counter: a value above
# ceil(old * 1.10) fails; decreases and growth within tolerance are reported.
function is_semantic(key) {
    return key ~ /_sha256$/ || key == "image_bytes"
}
# ceil(old * 1.10) in integer arithmetic: old + ceil(old / 10). Floating
# point would round 10 * 1.1 to 11.000000000000002 and allow 12.
function resource_limit(old,    tenth) {
    tenth = (old - old % 10) / 10
    if (old % 10 != 0)
        tenth++
    return old + tenth
}
function complain(message) {
    print "FAIL: " message
    failed = 1
}

# Parse both files into tables indexed by source (1 = baseline,
# 2 = current): present[source, fixture], fixtures[source, n] in file
# order, values[source, fixture, key], and keys[source, fixture], the
# fixture keys in record order. Malformed input is a failure, never skipped
# silently.
{
    source = FILENAME == ARGV[1] ? 1 : 2
    origin = source == 1 ? "baseline" : "current"
    if ($1 !~ /^fixture=./) {
        complain(origin " line " FNR " is not a fixture record: " $0)
        next
    }
    name = substr($1, 9)
    if ((source, name) in present) {
        complain(origin " repeats fixture " name)
        next
    }
    present[source, name] = 1
    count[source]++
    fixtures[source, count[source]] = name
    for (i = 2; i <= NF; i++) {
        split_at = index($i, "=")
        key = substr($i, 1, split_at - 1)
        value = substr($i, split_at + 1)
        if (split_at < 2 || value == "" || (source, name, key) in values) {
            complain(origin " " name " has a malformed or repeated field: " $i)
            continue
        }
        if (!is_semantic(key) && value !~ /^[0-9]+$/) {
            complain(origin " " name " " key " is not a counter: " value)
            continue
        }
        values[source, name, key] = value
        keys[source, name] = keys[source, name] " " key
    }
}

# Every fixture must appear in both files; common fixtures are compared key
# by key. Mismatches are all reported before the exit status is set.
END {
    if (count[1] == 0 || count[2] == 0)
        complain("expected both baseline and current records")
    for (n = 1; n <= count[1]; n++) {
        name = fixtures[1, n]
        if (!((2, name) in present))
            complain(name ": fixture missing from current records")
    }
    for (n = 1; n <= count[2]; n++) {
        name = fixtures[2, n]
        if (!((1, name) in present)) {
            complain(name ": fixture not in baseline")
            continue
        }
        compare(name)
    }
    if (failed) {
        print "Baseline mismatch. Fix the regression, or re-record with"
        print "make baseline-record and explain every change in the commit."
        exit 1
    }
    print "PASS: " count[2] " fixtures match the baseline"
}

# Compare one fixture: a key in only one file fails; semantic values must
# be identical strings; counters compare numerically against the limit.
function compare(name,    old_keys, new_keys, old_count, new_count, k, key,
    old, new) {
    old_count = split(keys[1, name], old_keys, " ")
    new_count = split(keys[2, name], new_keys, " ")
    for (k = 1; k <= old_count; k++) {
        if (!((2, name, old_keys[k]) in values))
            complain(name " " old_keys[k] ": key missing from current records")
    }
    for (k = 1; k <= new_count; k++) {
        key = new_keys[k]
        if (!((1, name, key) in values)) {
            complain(name " " key ": key not in baseline")
            continue
        }
        old = values[1, name, key]
        new = values[2, name, key]
        if (is_semantic(key)) {
            if (old != new)
                complain(name " " key ": baseline " old ", current " new)
        } else if (new + 0 > resource_limit(old + 0)) {
            complain(name " " key ": baseline " old ", current " new \
                ", limit " resource_limit(old + 0))
        } else if (new + 0 < old + 0) {
            print "improved: " name " " key ": baseline " old ", current " new
        } else if (new + 0 > old + 0) {
            print "grew within tolerance: " name " " key ": baseline " old \
                ", current " new
        }
    }
}
' "$baseline" "$work/current"
