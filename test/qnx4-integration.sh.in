#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Stanislav Sedov <stas@deglitch.com>
#
# Independent QNX4 evidence. The fixtures are external inputs that are never
# redistributed:
#   FSIMG_QNX4_NATIVE     a directory of QNX 6.5.0 captures, q4-*.img.gz,
#                         with the guest's manifests q4-manifest-*.txt
#   FSIMG_QNX4_H1         a disk image holding a QNX4 partition, read only
#   FSIMG_QNX4_H1_OFFSET  that partition's byte offset
#   FSIMG_QNX4_H1_LENGTH  and its byte length
#   QNXPROBE              a qnxprobe command at a pinned revision, run as
#                         $QNXPROBE IMAGE on each volume's exact slice
#   FSIMG_QNX4_LINUX      1 to mount volumes with the Linux qnx4 driver
# Every capture and the partition must verify completely, and fsimg's
# empty volumes must equal the empty captures of their geometry. The H1
# survey runs only info and verify and reports counts, never names. When
# asked for, the Linux kernel's qnx4 driver, mounted read only from a loop
# device on a Linux host as root, compares its view of the generated sample volume and
# of every capture with fsimg's, and reads writer output; qnxprobe, when
# its command is given, must accept the same volumes. Mounting hands each
# image to the host kernel's driver, so give FSIMG_QNX4_NATIVE only
# captures made with the project's harness. Each unavailable check is
# reported as a skip.
set -eu
ran=0
fixture=$(mktemp -d "${TMPDIR:-/tmp}/fsimg-qnx4-oracle-XXXXXX")
trap 'umount "$fixture/mnt" 2>/dev/null || true; rm -rf "$fixture"' EXIT
trap 'exit 1' HUP INT TERM

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

# Whether the Linux kernel's qnx4 driver is asked for and can be mounted
# here. Mounting hands images to the host kernel, so it is never implicit.
linux=0
if test "${FSIMG_QNX4_LINUX:-0}" = 1 && test "$(uname -s)" = Linux &&
    test "$(id -u)" = 0 &&
    { grep -qw qnx4 /proc/filesystems || modprobe qnx4 2>/dev/null; }; then
    linux=1
    mkdir "$fixture/mnt"
fi
probe=${QNXPROBE:-}

# A capture named *-N-file holds a volume of N blocks formatted on a file at
# the start of the disk; every other capture is formatted on the whole disk.
slice_bytes() {
    case $1 in
    *-file)
        blocks=${1%-file}
        blocks=${blocks##*-}
        echo $((blocks * 512))
        ;;
    *)
        wc -c < "$2" | tr -d ' '
        ;;
    esac
}

# The native manifest $1 as the tab-separated lines fsimg_lines writes:
# "E path mode links uid gid size [target]" for each ls -l line and "C path
# crc size" for each cksum line. ls shows the format-owned .bitmap, .inodes
# and .longfilenames, which fsimg does not list; root is owner 0. The
# captures' names hold no blanks, so ls lines split on blanks.
native_lines() {
    awk -v OFS='\t' '
    function name(p) { return p == "." ? "/" : substr(p, 2) }
    function hidden(p) {
        return p == "./.bitmap" || p == "./.inodes" ||
            p == "./.longfilenames"
    }
    function owner(o) { return o == "root" ? 0 : o }
    /^---- output ----$/ { body = 1; next }
    !body || $0 == "exit: 0" { next }
    length($1) == 10 && $1 ~ /^[-dlp]/ {
        if (hidden($9))
            next
        if ($10 == "->")
            print "E", name($9), $1, $2, owner($3), owner($4), $5, $11
        else
            print "E", name($9), $1, $2, owner($3), owner($4), $5
        next
    }
    NF == 3 && $1 ~ /^[0-9]+$/ && $3 ~ /^\.\// {
        if (!hidden($3))
            print "C", name($3), $1, $2
        next
    }
    { print "unparsed native line: " $0 > "/dev/stderr"; exit 1 }
    ' "$1"
}

# fsimg's view of the volume at byte $3 of image $1, $2 bytes long, written
# to the file $4: the manifest lines, then each regular file's POSIX
# checksum through fsimg x -O. Any failure fails the script.
fsimg_lines() {
    ./test-qnx4 --manifest "$1" "$3" "$2" > "$4"
    awk -F '\t' '$1 == "E" && $3 ~ /^-/ { print $2 }' "$4" > "$fixture/files"
    while IFS= read -r path; do
        ./fsimg x -O --offset="$3" --length="$2" -f "$1" "$path" \
            > "$fixture/content" 2>/dev/null ||
            fail "fsimg x -O failed on a file of $1"
        cksum < "$fixture/content" > "$fixture/sum"
        read -r crc size < "$fixture/sum"
        printf 'C\t%s\t%s\t%s\n' "$path" "$crc" "$size" >> "$4"
    done < "$fixture/files"
    rm -f "$fixture/files" "$fixture/content" "$fixture/sum"
}

# Full verification of the volume at byte $3 of image $1, $2 bytes long,
# with payload read-through, which reads every file; the JSON verify record
# goes to the file $4. It fails unless the report is complete. fsimg's
# diagnostic can quote a name, so it is shown only when $5 is "show", for
# the public captures; the private partition's stays hidden.
fsimg_verify() {
    if ./fsimg W --json -d --offset="$3" --length="$2" -f "$1" > "$4" \
        2> "$fixture/verify-error" &&
        grep -q '"type":"verify","complete":true' "$4"; then
        return 0
    fi
    if test "$5" = show; then
        grep -v 'sandbox unavailable' "$fixture/verify-error" >&2 || true
    fi
    return 1
}

# The value of counter $1 in the verify record file $2, which must hold it.
verify_count() {
    value=$(sed -n 's/.*"type":"verify".*"'"$1"'":"\([0-9]*\)".*/\1/p' "$2")
    test -n "$value" || fail "the verify record has no $1"
    echo "$value"
}

# The lines of fsimg_lines' file $1 that another reader can be compared
# with, each prefixed by 1 when every component of its path is at most 48
# bytes and 0 otherwise: "E path kind value", with the value a regular
# file's size, a symbolic link's target or "-", and the "C" lines as they
# are. The root's line is left out.
comparable_lines() {
    LC_ALL=C awk -F '\t' -v OFS='\t' '
    function short(p,    n, part, i) {
        n = split(p, part, "/")
        for (i = 1; i <= n; i++)
            if (length(part[i]) > 48)
                return 0
        return 1
    }
    $1 == "E" && $2 != "/" {
        kind = substr($3, 1, 1)
        value = kind == "-" ? $7 : kind == "l" ? $8 : "-"
        print short($2), "E", $2, kind, value
    }
    $1 == "C" { print short($2), "C", $2, $3 " " $4 }
    ' "$1"
}

# The Linux view of the volume at the start of image $1, $2 bytes long, in
# comparable_lines' form without the prefix, written to the file $3. The
# kernel lists the format-owned .bitmap, .inodes and .longfilenames, which
# fsimg does not.
linux_lines() {
    mount -t qnx4 -o "ro,loop,sizelimit=$2" "$1" "$fixture/mnt" ||
        fail "the Linux qnx4 driver refuses to mount $1"
    (cd "$fixture/mnt" && find . -mindepth 1 -printf '%P\t%y\t%s\t%l\n') |
        LC_ALL=C awk -F '\t' -v OFS='\t' '
        $1 == ".bitmap" || $1 == ".inodes" || $1 == ".longfilenames" {
            next
        }
        {
            kind = $2 == "f" ? "-" : $2 == "d" ? "d" : $2 == "l" ? "l" : $2
            value = kind == "-" ? $3 : kind == "l" ? $4 : "-"
            print "E", "/" $1, kind, value
        }' > "$3"
    awk -F '\t' '$1 == "E" && $3 == "-" { print $2 }' "$3" > "$fixture/files"
    while IFS= read -r path; do
        cksum < "$fixture/mnt$path" > "$fixture/sum" ||
            fail "Linux cannot read a file of $1"
        read -r crc size < "$fixture/sum"
        printf 'C\t%s\t%s %s\n' "$path" "$crc" "$size" >> "$3"
    done < "$fixture/files"
    umount "$fixture/mnt"
    rm -f "$fixture/files" "$fixture/sum"
}

# Compare the Linux view of the volume at the start of image $1, $2 bytes
# long, with fsimg's lines in the file $3, for the volume named $4. Every
# entry fsimg lists below names of at most 48 bytes must appear in Linux
# with the same kind, size or target and checksum. Linux shows a name over
# 48 bytes as its mangled 48-byte link field, so an entry below one is
# counted instead: both readers must list the same number of entries.
linux_compare() {
    comparable_lines "$3" > "$fixture/tagged"
    linux_lines "$1" "$2" "$fixture/linux"
    LC_ALL=C sort "$fixture/linux" > "$fixture/linux-sorted"
    awk -F '\t' '$1 == 1' "$fixture/tagged" | cut -f 2- | LC_ALL=C sort \
        > "$fixture/short"
    missing=$(LC_ALL=C comm -23 "$fixture/short" "$fixture/linux-sorted" |
        wc -l | tr -d ' ')
    if test "$missing" != 0; then
        LC_ALL=C comm -23 "$fixture/short" "$fixture/linux-sorted" |
            cut -c 1-160 >&2
        fail "$4: Linux $(uname -r) reads $missing lines differently"
    fi
    total=$(wc -l < "$fixture/tagged" | tr -d ' ')
    seen=$(wc -l < "$fixture/linux" | tr -d ' ')
    test "$total" = "$seen" ||
        fail "$4: Linux $(uname -r) lists $seen lines, fsimg $total"
    echo "$4: Linux $(uname -r) agrees on $total lines," \
        "$((total - $(wc -l < "$fixture/short"))) below a name over 48 bytes"
    rm -f "$fixture/tagged" "$fixture/linux" "$fixture/linux-sorted" \
        "$fixture/short"
}

# qnxprobe must accept the volume at the start of image $1, $2 bytes long,
# which fsimg verifies, given as its exact slice; $3 names the volume, a
# public one, so qnxprobe's output is shown when it refuses.
probe_compare() {
    if test "$(wc -c < "$1" | tr -d ' ')" = "$2"; then
        slice=$1
    else
        slice=$fixture/slice
        dd if="$1" of="$slice" bs=512 count=$(($2 / 512)) 2>/dev/null
    fi
    # QNXPROBE may hold arguments, so it is split into words on purpose,
    # without pathname expansion.
    set -f
    # shellcheck disable=SC2086
    if ! $probe "$slice" > "$fixture/probe" 2>&1; then
        tail -n 20 "$fixture/probe" | cut -c 1-160 >&2
        fail "$3: qnxprobe refuses a volume fsimg verifies"
    fi
    set +f
    echo "$3: qnxprobe accepts it ($(wc -l < "$fixture/probe" |
        tr -d ' ') lines)"
    rm -f "$fixture/slice" "$fixture/probe"
}

# The generated sample: every entry kind, 16-, 48- and 505-byte names, a
# nested tree, a hard link in .inodes and a 61-extent file.
./test-qnx4 --seed "$fixture/sample.img"
length=$(wc -c < "$fixture/sample.img" | tr -d ' ')
fsimg_verify "$fixture/sample.img" "$length" 0 "$fixture/verify" show ||
    fail "the generated sample does not verify"
if test "$linux" = 1 || test -n "$probe"; then
    fsimg_lines "$fixture/sample.img" "$length" 0 "$fixture/lines"
    if test "$linux" = 1; then
        linux_compare "$fixture/sample.img" "$length" "$fixture/lines" \
            sample
        ran=1
    fi
    if test -n "$probe"; then
        probe_compare "$fixture/sample.img" "$length" sample
        ran=1
    fi
fi

native=${FSIMG_QNX4_NATIVE:-}
if test -n "$native"; then
    compared=0
    for capture in "$native"/q4-*.img.gz; do
        test -f "$capture" || continue
        name=$(basename "$capture" .img.gz)
        gzip -d -c "$capture" > "$fixture/image"
        length=$(slice_bytes "$name" "$fixture/image")
        ./fsimg i --json --length="$length" -f "$fixture/image" \
            > "$fixture/info" 2>/dev/null || fail "fsimg i failed on $name"
        grep -q '"format":"qnx4"' "$fixture/info" ||
            fail "$name is not read as QNX4"
        ./fsimg t --length="$length" -f "$fixture/image" > "$fixture/ls" \
            2>/dev/null || fail "fsimg t failed on $name"
        listed=$(wc -l < "$fixture/ls" | tr -d ' ')
        fsimg_verify "$fixture/image" "$length" 0 "$fixture/verify" show ||
            fail "$name does not verify"
        free=$(verify_count free_clusters "$fixture/verify")
        fsimg_lines "$fixture/image" "$length" 0 "$fixture/lines"
        LC_ALL=C sort "$fixture/lines" > "$fixture/fsimg"
        entries=$(awk -F '\t' '$1 == "E" { n++ } END { print n + 0 }' \
            "$fixture/fsimg")
        test "$entries" -eq $((listed + 1)) ||
            fail "$name: fsimg t lists $listed of $((entries - 1)) entries"
        case $name in
        q4-manifest-*)
            manifest=$native/$name.txt
            test -f "$manifest" || fail "$name has no manifest"
            native_lines "$manifest" > "$fixture/native-lines"
            LC_ALL=C sort "$fixture/native-lines" > "$fixture/native"
            if ! cmp -s "$fixture/native" "$fixture/fsimg"; then
                diff "$fixture/native" "$fixture/fsimg" | cut -c 1-160 >&2 ||
                    true
                fail "$name differs from its native manifest"
            fi
            echo "$name: $listed entries match the native manifest;" \
                "verified, $free blocks free"
            compared=$((compared + 1))
            ;;
        *)
            echo "$name: $listed entries read; verified, $free blocks free"
            ;;
        esac
        if test "$linux" = 1; then
            linux_compare "$fixture/image" "$length" "$fixture/lines" "$name"
        fi
        if test -n "$probe"; then
            probe_compare "$fixture/image" "$length" "$name"
        fi
        rm -f "$fixture/image"
    done
    test "$compared" != 0 || fail "$native holds no manifest captures"
    # The writer's empty volume of each empty capture's geometry, label and
    # format time: every byte but the loader block's must match.
    rc=0
    ./test-qnx4-write --native "$native" || rc=$?
    case $rc in
    0) ;;
    77) echo "SKIP: $native holds no empty capture for the writer" ;;
    *) fail "fsimg's empty volumes differ from the native captures" ;;
    esac
    ran=1
else
    echo 'SKIP: FSIMG_QNX4_NATIVE is not set (QNX 6.5.0 captures)'
fi

# The PCM partition, opened in place and read only, through info and
# verification with payload read-through alone, which reads every file;
# only counts are printed.
h1=${FSIMG_QNX4_H1:-}
if test -n "$h1"; then
    offset=${FSIMG_QNX4_H1_OFFSET:?FSIMG_QNX4_H1_OFFSET is required}
    length=${FSIMG_QNX4_H1_LENGTH:?FSIMG_QNX4_H1_LENGTH is required}
    ./fsimg i --json --offset="$offset" --length="$length" -f "$h1" \
        > "$fixture/info" 2>/dev/null ||
        fail "fsimg i failed on the H1 partition"
    grep -q '"format":"qnx4"' "$fixture/info" ||
        fail "the H1 partition is not read as QNX4"
    fsimg_verify "$h1" "$length" "$offset" "$fixture/verify" hide ||
        fail "the H1 partition does not verify"
    directories=$(verify_count directories "$fixture/verify")
    files=$(verify_count files "$fixture/verify")
    read_bytes=$(verify_count initialized_bytes_read "$fixture/verify")
    allocated=$(verify_count allocated_clusters "$fixture/verify")
    free=$(verify_count free_clusters "$fixture/verify")
    echo "H1: verified, $directories directories with the root and" \
        "$files other entries, $read_bytes bytes read; $allocated blocks" \
        "allocated, $free free"
    ran=1
else
    echo 'SKIP: FSIMG_QNX4_H1 is not set (PCM partition, counts only)'
fi

# The Linux kernel's driver as an independent reader of writer output:
# every file the writer was given must read back through the mount with the
# POSIX cksum and size of its manifest line. Linux shows a name over 48
# bytes as its 48-byte link field, the mangled prefix, so a file below such
# a name is counted, not compared.
if test "$linux" = 1; then
    mkdir "$fixture/writer"
    ./test-qnx4-write --create "$fixture/writer" tree 0 > /dev/null
    mount -t qnx4 -o ro,loop "$fixture/writer/writer.img" "$fixture/mnt" ||
        fail 'the Linux qnx4 driver refuses to mount writer output'
    LC_ALL=C awk -F '\t' '$1 == "C" {
        long = 0
        n = split($2, part, "/")
        for (i = 1; i <= n; i++)
            if (length(part[i]) > 48)
                long = 1
        print long "\t" $2 "\t" $3 " " $4
    }' "$fixture/writer/writer.manifest" > "$fixture/contents"
    tab=$(printf '\t')
    compared=0
    long=0
    while IFS=$tab read -r prefixed path expected; do
        if test "$prefixed" = 1; then
            long=$((long + 1))
            continue
        fi
        actual=$(cksum < "$fixture/mnt$path") ||
            fail "Linux cannot read $path"
        test "$actual" = "$expected" ||
            fail "Linux reads $path as $actual, the writer wrote $expected"
        compared=$((compared + 1))
    done < "$fixture/contents"
    test "$compared" != 0 || fail 'the writer manifest names no file to compare'
    umount "$fixture/mnt"
    echo "Linux $(uname -r) qnx4: $compared writer files match their" \
        "manifest; $long below a name over 48 bytes"
else
    echo "SKIP: the Linux qnx4 kernel reader needs FSIMG_QNX4_LINUX=1," \
        "a Linux host, root and the qnx4 driver; this is $(uname -s) as" \
        "uid $(id -u)"
fi
if test -z "$probe"; then
    echo 'SKIP: QNXPROBE is not set (qnxprobe comparison)'
fi

if test "$ran" = 0; then
    exit 77
fi
