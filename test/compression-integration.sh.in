#!/bin/sh
# SPDX-License-Identifier: BSD-2-Clause
# Copyright (c) 2026 Stanislav Sedov <stas@deglitch.com>
#
# fsimg reads the gzip files independent compressors write: gzip(1) and
# pigz output of a raw image, a file and a stream, and members gzip wrote
# separately and concatenated, each reading exactly as the raw image and
# as zcat expands it. The gzip files fsimg writes pass gzip -t and expand
# under zcat to the image fsimg writes without gzip, and a gzipped DMG
# expands to a DMG hdiutil verifies. Each missing tool is reported; the
# xz profiles are checked with xz(1) in the same way. Each xz fixture
# carries seeded damage that fsimg must reject.
# The test skips only when no oracle is available.
set -eu
gzip=${GZIP_PROGRAM:-'@GZIP_PROGRAM@'}
xz=${XZ_PROGRAM:-'@XZ_PROGRAM@'}
pigz=${PIGZ:-'@PIGZ@'}
hdiutil=${HDIUTIL:-'@HDIUTIL@'}
fsimg="$(pwd)/fsimg"
fixture=$(mktemp -d "${TMPDIR:-/tmp}/fsimg-compression-oracle-XXXXXX")
trap 'rm -rf "$fixture"' EXIT HUP INT TERM
cd "$fixture"
mkdir source
printf 'hello\n' > source/HELLO.TXT
awk 'BEGIN { for (i = 0; i < 40000; i++) printf "line %d of a compressible file\n", i }' \
    > source/TEXT.TXT
"$fsimg" cf raw.img -F fat16 -s 16M -C source . 2>/dev/null
"$fsimg" tf raw.img > raw.txt 2>/dev/null
ran=0

fail() {
    echo "FAIL: $*" >&2
    exit 1
}

# A compressed file lists as the raw image, from the file and from
# standard input, reports gzip and verifies.
check_gzip() {
    "$fsimg" tf "$1" > listed.txt 2>/dev/null || fail "$1: listing"
    cmp -s listed.txt raw.txt || fail "$1 lists differently from raw.img"
    "$fsimg" tf - < "$1" > listed.txt 2>/dev/null || fail "$1: stream listing"
    cmp -s listed.txt raw.txt || fail "$1 streamed lists differently"
    "$fsimg" if "$1" 2>/dev/null | grep -q '^Compression:  gzip$' ||
        fail "$1: compression not reported"
    "$fsimg" Wf "$1" > /dev/null 2>&1 || fail "$1: verification"
}

if test -n "$gzip"; then
    "$gzip" -c raw.img > gzip.img.gz
    "$gzip" -dc gzip.img.gz | cmp -s - raw.img || fail "gzip round trip"
    check_gzip gzip.img.gz
    # Two halves compressed apart, then concatenated: gzip -d reads them as
    # one file, and so must fsimg.
    head -c 8388608 raw.img | "$gzip" -c > halves.img.gz
    tail -c +8388609 raw.img | "$gzip" -nc >> halves.img.gz
    "$gzip" -dc halves.img.gz | cmp -s - raw.img || fail "gzip members"
    check_gzip halves.img.gz
    ran=$((ran + 1))
else
    echo 'SKIP: gzip is required for the gzip oracle'
fi

# What fsimg writes: gzip -t accepts it and zcat yields the raw image, bare
# and as a stream, at the fastest and slowest levels.
if test -n "$gzip"; then
    "$fsimg" cf raw-r.img -R -F fat16 -s 16M -C source . 2>/dev/null
    for level in 1 9; do
        "$fsimg" cf written.img.gz -a -R -F fat16 -s 16M -o "gzip:level=$level" \
            -C source . 2>/dev/null || fail "gzip output at level $level"
        "$gzip" -t written.img.gz || fail "gzip -t rejects level $level output"
        "$gzip" -dc written.img.gz | cmp -s - raw-r.img ||
            fail "zcat of level $level output differs from the raw image"
        rm -f written.img.gz
    done
    # A flipped CRC32 byte proves gzip -t checks the member fsimg wrote.
    "$fsimg" cf flipped.img.gz -a -R -F fat16 -s 16M -C source . \
        2>/dev/null || fail "gzip output for the flipped CRC32"
    size=$(wc -c < flipped.img.gz)
    byte=$(od -An -tu1 -j $((size - 8)) -N1 flipped.img.gz | tr -d ' ')
    printf "$(printf '\\%03o' $((byte ^ 255)))" |
        dd of=flipped.img.gz bs=1 seek=$((size - 8)) conv=notrunc 2>/dev/null
    if "$gzip" -t flipped.img.gz 2>/dev/null; then
        fail "gzip -t accepts a member with a flipped CRC32"
    fi
    "$fsimg" cf - -z -R -F fat16 -s 16M -C source . 2>/dev/null > streamed.gz ||
        fail "gzip stream output"
    "$gzip" -t streamed.gz || fail "gzip -t rejects the streamed output"
    "$gzip" -dc streamed.gz | cmp -s - raw-r.img || fail "zcat of the stream differs"
    ran=$((ran + 1))
    if test -n "$hdiutil"; then
        "$fsimg" cf disk.dmg.gz -a -R -F fat16/gpt/dmg -s 16M -C source . \
            2>/dev/null || fail "gzipped DMG output"
        "$gzip" -t disk.dmg.gz || fail "gzip -t rejects the gzipped DMG"
        "$gzip" -dc disk.dmg.gz > disk.dmg
        "$hdiutil" verify disk.dmg > /dev/null 2>&1 ||
            fail "hdiutil verify rejects the DMG inside gzip"
        ran=$((ran + 1))
    else
        echo 'SKIP: hdiutil is required to verify the DMG inside gzip output'
    fi
fi
if test -n "$pigz"; then
    "$pigz" -c -p 4 -b 128 raw.img > pigz.img.gz
    "$pigz" -dc pigz.img.gz | cmp -s - raw.img || fail "pigz round trip"
    check_gzip pigz.img.gz
    # Independent blocks reset the dictionary at each block boundary.
    "$pigz" -c -p 4 -b 128 -i raw.img > independent.img.gz
    check_gzip independent.img.gz
    ran=$((ran + 1))
else
    echo 'SKIP: pigz is required for the pigz oracle'
fi

# The xz oracle uses a small, reproducible FAT image. Its purpose is to
# check the compression envelope, not FAT capacity or large-file copying.
check_xz() {
    "$fsimg" tf "$1" > listed.txt 2>/dev/null || fail "$1: xz listing"
    cmp -s listed.txt xz-raw.txt || fail "$1: xz listing differs"
    "$fsimg" tf - < "$1" > listed.txt 2>/dev/null || fail "$1: xz stdin"
    cmp -s listed.txt xz-raw.txt || fail "$1: xz stdin differs"
    "$fsimg" Wf "$1" > /dev/null 2>&1 || fail "$1: xz verification"
}

flip_byte() {
    byte=$(od -An -tu1 -j "$2" -N1 "$1" | tr -d ' ')
    printf "$(printf '\\%03o' $((byte ^ 1)))" |
        dd of="$1" bs=1 seek="$2" conv=notrunc 2>/dev/null
}

reject_xz() {
    if "$fsimg" Wf "$1" >/dev/null 2>&1; then
        fail "fsimg accepts $1"
    fi
    if "$xz" -t "$1" 2>/dev/null; then
        fail "xz -t accepts $1"
    fi
}

damage_xz_index() {
    size=$(wc -c < "$1")
    flip_byte "$1" $((size - 16))
    reject_xz "$1"
}

if test -z "$xz" || ! test -x "$xz"; then
    echo 'SKIP: xz is required for the xz oracle'
elif ! "$fsimg" --formats | awk '
    $1 == "xz" && $2 == "compression" && $3 == "yes" { found = 1 }
    END { exit !found }'; then
    echo 'SKIP: xz oracle requires a build with liblzma'
else
    "$fsimg" cf xz-raw.img -R -F fat12 -s 1M -C source HELLO.TXT 2>/dev/null
    "$fsimg" tf xz-raw.img > xz-raw.txt 2>/dev/null
    for level in 0 6 9; do
        for check in crc32 crc64 sha256; do
            "$fsimg" cf written.img.xz -a -R -F fat12 -s 1M \
                -m 1G -o "xz:level=$level" -o "xz:check=$check" \
                -C source HELLO.TXT 2>/dev/null || fail "xz write $level $check"
            "$xz" -t written.img.xz || fail "xz -t $level $check"
            "$xz" -dc written.img.xz | cmp -s - xz-raw.img ||
                fail "xz decoded bytes $level $check"
            # xz's file row states streams, blocks and check independently
            # of fsimg's decoder. Its check names are uppercase.
            "$xz" -l --robot written.img.xz | awk -F '\t' -v check="$check" '
                $1 == "file" {
                    actual = tolower($7)
                    gsub(/-/, "", actual)
                    if ($2 == 1 && $3 == 1 && actual == check) found = 1
                }
                END { exit !found }' || fail "xz stream/block/check $level $check"
            check_xz written.img.xz
            header=$(od -An -tu1 -j 12 -N1 written.img.xz | tr -d ' ')
            flip_byte written.img.xz $((12 + (header + 1) * 4 + 5))
            reject_xz written.img.xz
            rm written.img.xz
        done
        for check in none crc32 crc64 sha256; do
            "$xz" -c -"$level" --check="$check" xz-raw.img > oracle.xz
            check_xz oracle.xz
            # Index CRC32 remains mandatory even with no block check.
            damage_xz_index oracle.xz
        done
    done
    "$xz" -c -0 -T0 --block-size=64KiB xz-raw.img > multiblock.xz
    "$xz" -l --robot multiblock.xz | awk -F '\t' '
        $1 == "file" && $2 == 1 && $3 > 1 { found = 1 }
        END { exit !found }' || fail 'xz fixture must contain multiple blocks'
    check_xz multiblock.xz
    damage_xz_index multiblock.xz

    head -c 524288 xz-raw.img | "$xz" -c -0 > first.xz
    tail -c +524289 xz-raw.img | "$xz" -c -0 > second.xz
    for padding in 0 4 8; do
        cat first.xz > joined.xz
        dd if=/dev/zero bs=1 count="$padding" 2>/dev/null >> joined.xz
        cat second.xz >> joined.xz
        check_xz joined.xz
        printf '\000' >> joined.xz
        reject_xz joined.xz
    done
    cat first.xz > bad-padding.xz
    printf '\000\000\000\000\000' >> bad-padding.xz
    cat second.xz >> bad-padding.xz
    reject_xz bad-padding.xz
    ran=$((ran + 1))
fi

if test "$ran" -eq 0; then
    exit 77
fi
echo "PASS: $ran compression oracles"
